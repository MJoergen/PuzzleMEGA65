-- The properties of snapshot.vhd, the picture of the board: the protocol of
-- the two buffers (no tearing) and of the hold of the shown context. The
-- solver (busy_i and the path) and the frames are free.

vunit i_snapshot(snapshot(rtl))
{
   -- set all declarations to run on clk_i
   default clock is rising_edge(clk_i);


   -----------------------------
   -- ASSUMPTIONS
   -----------------------------

   -- The design starts in reset
   f_reset : assume {rst_i};


   -----------------------------
   -- ASSERTIONS
   -----------------------------

   -- The buffer that was sent last (and that the VGA clock domain shows) is
   -- never written, so the picture never tears
   -- (Written without an implication, which would also be a cover statement
   -- in the cover task: writing the board takes thousands of clock cycles,
   -- far more than the depth of the cover task.)
   f_buffer : assert always (wr_en_o = '0' or rst_i = '1' or wr_addr_o(8) /= sent_r);

   -- The statistics are sent with the buffer that was just written (sent_r),
   -- and then the other buffer (buf_r) is written
   f_alternate : assert always {sent_r /= buf_r};

   -- The squares written are on the board of the puzzle
   f_square : assert always (wr_en_o = '0' or rst_i = '1' or
      to_integer(wr_addr_o(7 downto 0)) < C_PUZZLES(puzzle_r).squares);

   -- The statistics are taken while the context is held and had no pass in
   -- the pipeline (two clock cycles before, as busy_i and latch_o are
   -- registered), so
   -- they belong to the position of the picture
   f_latch : assert always {latch_o = '1'} |-> {hold_r = '1' and state_r = VIS_ST};
   f_latch_busy : assert always {hold_r = '1' and busy_i(ctx_r) = '1' and rst_i = '0'} |=>
      {true; latch_o = '0'};
   f_busy_r : assert always {hold_r = '1' and rst_i = '0'} |=> {busy_r = prev(busy_i(ctx_r))};

   -- The path is only read while the context is held, and the held context
   -- does not change while it is held
   f_path : assert always {state_r = PATH_ST} |-> {hold_r = '1'};
   f_hold_ctx : assert always {hold_r = '1' and rst_i = '0'} |=> {stable(ctx_r) or hold_r = '0'};

   -- The hold ends when the path has been read
   f_hold : assert always {hold_r = '1'} |-> {state_r = HOLD_ST or state_r = VIS_ST or state_r = PATH_ST};
   f_held : assert always {state_r = HOLD_ST or state_r = VIS_ST or state_r = PATH_ST} |-> {hold_r = '1'};


   -----------------------------
   -- COVER STATEMENTS
   -----------------------------

   -- The picture is being made
   f_cover : cover {state_r = PATH_ST; state_r = CLEAR_ST};

} -- vunit i_snapshot(snapshot(rtl))
